# Copy to .env only if that file does not exist. Keep real credentials out of Git.
# This template is for local development, not a production deployment.

# Server. Use HOST=0.0.0.0 when testing from an iPhone on the same trusted Wi-Fi.
# Port 8082 matches the local mobile setup; update the mobile URL if it changes.
NODE_ENV=development
HOST=127.0.0.1
PORT=8082

# Local PostgreSQL started by: docker compose up -d
# These credentials are local development defaults from compose.yaml.
DATABASE_URL=postgresql://mia:mia_local_password@localhost:54329/mia
CORS_ORIGINS=http://localhost:8081
MEDIA_DIRECTORY=.data/media

# Optional local-only fallback for unlisted numbers. Leave empty for test arrays only.
# If enabled, use a six-digit code. This fallback is always disabled in production.
DEV_OTP_CODE=

# Test sign-in accounts, supported in every environment including production.
# JSON arrays of strings: number at index 0 uses code at index 0, and so on.
# Add as many pairs as needed. Both arrays must have equal lengths; numbers must be unique.
# Use full international numbers (+country code) and six-digit codes (keep leading zeros).
# No SMS is sent. Codes stay on the backend. Empty arrays disable test sign-in.
# TEST_PHONE_NUMBERS='["+12025550101","+12025550102"]'
# TEST_OTP_CODES='["012345","654321"]'
TEST_PHONE_NUMBERS=[]
TEST_OTP_CODES=[]

# Meta Model API: https://dev.meta.ai/
# Dashboard > API keys > Create API key.
# Meta docs call this MODEL_API_KEY; this application reads META_API_KEY instead.
# One Meta key is used for the agent and speech recognition.
# Leave blank until you have a real key; the related features stay unavailable.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0

# Google Cloud: https://console.cloud.google.com/apis/credentials
# Enable Cloud Text-to-Speech API and billing in the key's project.
# Allow Cloud Text-to-Speech API in the key's API restrictions.
# Keep this secret on the backend; never use EXPO_PUBLIC_* for provider keys.
GOOGLE_TTS_API_KEY=
# Selected speech model/voice and separate delivery instructions.
# Gemini also needs Vertex AI API and aiplatform.endpoints.predict permission.
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
GOOGLE_TTS_VOICE=Kore
GOOGLE_TTS_PROMPT="Speak calmly and naturally, with restrained warmth and clear everyday conversational delivery."
# ADC: attached service account, GOOGLE_APPLICATION_CREDENTIALS, or gcloud ADC.
# The authenticated identity needs roles/aiplatform.user in the project.
GOOGLE_TTS_AUTH=adc
GOOGLE_TTS_PROJECT=
# For a downloaded service-account key, keep it OUTSIDE the repository:
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/.config/mia/tts-service-account.json
# Standard voices can use an API key without ADC. To restore Neural2:
# GOOGLE_TTS_MODEL=standard
# GOOGLE_TTS_AUTH=api-key
# GOOGLE_TTS_VOICE=en-US-Neural2-F
# Neural2-F/J support these SSML styles: calm, empathetic, lively, firm, apologetic.
# Use none for the original delivery. Other voices use plain text.
GOOGLE_TTS_STYLE=calm

LOG_LEVEL=info
