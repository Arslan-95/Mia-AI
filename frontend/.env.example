# Copy to .env.local only if that file does not exist.
# Simulator/local development address:
EXPO_PUBLIC_API_URL=http://127.0.0.1:8082

# For a physical iPhone, replace 127.0.0.1 above with your computer's Wi-Fi IPv4
# address, for example http://192.168.1.42:8082. Use the same trusted Wi-Fi.
# The backend must listen on HOST=0.0.0.0 and the port must be reachable.
# Restart Expo after editing. A saved URL in Settings may override this default.
# EXPO_PUBLIC_* values are included in the app. Never put API keys or OTP here.
