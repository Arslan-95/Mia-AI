{
  "expo": {
    "name": "Mia",
    "slug": "mia-ai",
    "version": "1.0.0",
    "scheme": "mia",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mia.messenger",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record a voice note or speak a request to Mia, only when you choose.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Record a voice note or speak a request to Mia, only when you choose.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      ["expo-build-properties", { "ios": { "useFrameworks": "dynamic" } }]
    ],
    "platforms": [
      "ios"
    ],
    "extra": {
      "eas": {
        "projectId": "4e9da75b-6212-4954-9933-3149997c7f8c"
      }
    },
    "owner": "s_arslan"
  }
}
