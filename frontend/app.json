{
  "expo": {
    "name": "Mia",
    "slug": "mia-ai",
    "version": "1.0.0",
    "scheme": "mia",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mia.messenger",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record a voice note or speak a request to Mia, only when you choose."
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Record a voice note or speak a request to Mia, only when you choose.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "platforms": [
      "ios"
    ]
  }
}
