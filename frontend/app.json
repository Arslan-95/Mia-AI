{
  "expo": {
    "name": "Mia",
    "slug": "mia-ai",
    "version": "1.0.0",
    "scheme": "mia",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mia.messenger",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record a voice note or speak a request to Mia, only when you choose."
      }
    },
    "android": {
      "package": "app.mia.messenger",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Record a voice note or speak a request to Mia, only when you choose.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "web": {
      "bundler": "metro",
      "name": "Mia — a little closer"
    }
  }
}
