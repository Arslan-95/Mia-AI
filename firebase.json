{
  "functions": [{
    "source": "firebase-functions",
    "codebase": "mia-auth",
    "ignore": ["node_modules", ".git", ".env", ".env.*", ".secret.local", ".data", "*.log"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" test"]
  }],
  "firestore": [{
    "database": "mia-auth-limits",
    "rules": "firebase-functions/firestore.rules"
  }],
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8098 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
